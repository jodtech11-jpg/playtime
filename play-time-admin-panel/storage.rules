rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ?
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role :
             null;
    }

    function getUserData() {
      return userExists() ?
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data :
             null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && userExists() && getUserRole() == 'super_admin';
    }

    function isVenueManager() {
      return isAuthenticated() &&
             userExists() &&
             getUserData().status == 'Active' &&
             getUserRole() == 'venue_manager';
    }

    function hasCustomAdminRole() {
      return isAuthenticated() &&
             userExists() &&
             getUserData().status == 'Active' &&
             getUserRole() is string &&
             !(getUserRole() in ['super_admin', 'player', 'venue_manager']) &&
             firestore.exists(/databases/(default)/documents/roles/$(getUserRole()));
    }

    function isAdminOperator() {
      return isSuperAdmin() || isVenueManager() || hasCustomAdminRole();
    }

    function ownsVenue(venueId) {
      return isSuperAdmin() ||
             (isAdminOperator() &&
              getUserData().managedVenues is list &&
              venueId in getUserData().managedVenues);
    }

    function canWriteDraft() {
      return isAdminOperator();
    }

    // Create-form folders. Do NOT require a Firestore role lookup here —
    // Storage→Firestore gets can fail and falsely deny Super Admin uploads.
    // Paths are still auth-gated + type/size limited; filenames are unique.
    function isDraftOrTempFolder(id) {
      return id == 'temp' || id.matches('draft_.*');
    }

    function canManageTournament(tournamentId) {
      return isSuperAdmin() ||
             (isAdminOperator() &&
              firestore.exists(/databases/(default)/documents/tournaments/$(tournamentId)) &&
              ownsVenue(
                firestore.get(/databases/(default)/documents/tournaments/$(tournamentId)).data.venueId
              ));
    }

    function canManageProduct(productId) {
      return isSuperAdmin() ||
             (isAdminOperator() &&
              firestore.exists(/databases/(default)/documents/products/$(productId)) &&
              firestore.get(/databases/(default)/documents/products/$(productId)).data.venueId != null &&
              ownsVenue(
                firestore.get(/databases/(default)/documents/products/$(productId)).data.venueId
              ));
    }

    function isAllowedImageType() {
      // Accept any image/* (covers image/png, image/jpeg, charset suffixes, etc.)
      return request.resource != null &&
             request.resource.contentType != null &&
             request.resource.contentType.matches('image/.*');
    }

    function underMaxSize() {
      // Max 15 MB per image upload (create/update only — request.resource is null on delete).
      return request.resource != null &&
             request.resource.size < 15 * 1024 * 1024;
    }

    function canUploadImage() {
      return isAuthenticated() && isAllowedImageType() && underMaxSize();
    }

    // ---------- Venue images ----------
    // Paths: venues/{venueId|draft_*|temp}/{fileName}
    match /venues/{venueId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUploadImage() &&
                             (isDraftOrTempFolder(venueId) ||
                              isSuperAdmin() ||
                              ownsVenue(venueId) ||
                              (isDraftOrTempFolder(venueId) && canWriteDraft()));
      allow delete: if isAuthenticated() &&
                    (isDraftOrTempFolder(venueId) ||
                     isSuperAdmin() ||
                     ownsVenue(venueId));
    }

    // ---------- User avatars ----------
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            (userId == request.auth.uid || isSuperAdmin()) &&
                            isAllowedImageType() &&
                            underMaxSize();
      allow delete: if isAuthenticated() &&
                    (userId == request.auth.uid || isSuperAdmin());
    }

    // ---------- Post images (Social Feed) ----------
    match /posts/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            userId == request.auth.uid &&
                            isAllowedImageType() &&
                            underMaxSize();
      allow delete: if isAuthenticated() && userId == request.auth.uid;
    }

    // ---------- Team images (TeamUp) ----------
    match /teams/{teamId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            (isSuperAdmin() ||
                             (firestore.exists(/databases/(default)/documents/teams/$(teamId)) &&
                              firestore.get(/databases/(default)/documents/teams/$(teamId)).data.createdBy
                                == request.auth.uid)) &&
                            isAllowedImageType() &&
                            underMaxSize();
      allow delete: if isAuthenticated() &&
                    (isSuperAdmin() ||
                     (firestore.exists(/databases/(default)/documents/teams/$(teamId)) &&
                      firestore.get(/databases/(default)/documents/teams/$(teamId)).data.createdBy
                        == request.auth.uid));
    }

    // ---------- Marketing campaigns (Super Admin only) ----------
    match /marketing/{campaignId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() && isAllowedImageType() && underMaxSize();
      allow delete: if isSuperAdmin();
    }

    // ---------- Flash deal images ----------
    // Paths: flash-deals/{dealId|draft_*|temp}/{fileName}
    match /flash-deals/{dealId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUploadImage() &&
                             (isDraftOrTempFolder(dealId) ||
                              isSuperAdmin() ||
                              isAdminOperator());
      allow delete: if isAuthenticated() &&
                    (isDraftOrTempFolder(dealId) ||
                     isSuperAdmin() ||
                     isAdminOperator());
    }

    // ---------- Tournaments ----------
    match /tournaments/{tournamentId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if canUploadImage() && (
        isDraftOrTempFolder(tournamentId) ||
        canManageTournament(tournamentId) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        isDraftOrTempFolder(tournamentId) ||
        canManageTournament(tournamentId) ||
        isSuperAdmin()
      );
    }

    // ---------- Products (marketplace images) ----------
    // Paths: products/{productId|draft_*|temp}/{fileName}
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUploadImage() &&
                             (isDraftOrTempFolder(productId) ||
                              isSuperAdmin() ||
                              canManageProduct(productId));
      allow delete: if isAuthenticated() &&
                     (isDraftOrTempFolder(productId) ||
                      isSuperAdmin() ||
                      canManageProduct(productId));
    }

    // ---------- Expense receipts ----------
    match /expenses/{expenseId}/{allPaths=**} {
      allow read: if isSuperAdmin() || isVenueManager();
      allow create, update: if (isSuperAdmin() || isVenueManager() ||
                               (isAuthenticated() && isDraftOrTempFolder(expenseId))) &&
                            isAllowedImageType() &&
                            underMaxSize();
      allow delete: if isSuperAdmin() || isVenueManager();
    }

    // ---------- Staff avatars ----------
    match /staff/{staffId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if (isSuperAdmin() || isVenueManager() ||
                               (isAuthenticated() && isDraftOrTempFolder(staffId))) &&
                            isAllowedImageType() &&
                            underMaxSize();
      allow delete: if isSuperAdmin() || isVenueManager();
    }

    // ---------- App Settings (Logo, etc. — Super Admin only) ----------
    match /app-settings/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            isAllowedImageType() &&
                            underMaxSize() &&
                            (isSuperAdmin() || isAdminOperator());
      allow delete: if isSuperAdmin();
    }

    // ---------- Default deny ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
