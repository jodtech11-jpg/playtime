rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ?
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role :
             null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && userExists() && getUserRole() == 'super_admin';
    }

    function isVenueManager() {
      return isAuthenticated() && userExists() && getUserRole() == 'venue_manager';
    }

    function getManagedVenues() {
      return userExists() ?
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.managedVenues :
             [];
    }

    function ownsVenue(venueId) {
      return isSuperAdmin() ||
             (isVenueManager() && venueId in getManagedVenues());
    }

    function isAllowedImageType() {
      // Accept any image/* (covers image/png, image/jpeg, charset suffixes, etc.)
      return request.resource != null &&
             request.resource.contentType != null &&
             request.resource.contentType.matches('image/.*');
    }

    function underMaxSize() {
      // Max 15 MB per image upload (create/update only — request.resource is null on delete).
      return request.resource != null &&
             request.resource.size < 15 * 1024 * 1024;
    }

    // Admin-panel operators who may manage marketplace assets.
    function canManageMarketplaceMedia() {
      return isAuthenticated() && userExists() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'venue_manager'
      );
    }

    // ---------- Venue images ----------
    // Paths: venues/{venueId|draft_*|temp}/{fileName}
    // Venue *document* writes stay gated in Firestore. Storage allows signed-in
    // users for image bytes so uploads are not blocked when Storage→Firestore
    // role lookups fail (same storage/unauthorized pattern as products).
    match /venues/{venueId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                             isAllowedImageType() &&
                             underMaxSize();
      allow delete: if isAuthenticated();
    }

    // ---------- User avatars ----------
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                   (userId == request.auth.uid || isSuperAdmin()) &&
                   isAllowedImageType() &&
                   underMaxSize();
    }

    // ---------- Post images (Social Feed) ----------
    // Path convention: posts/{userId}_{postId}/... OR posts/{postId}/...
    // We allow any authenticated user to upload their own post images but require
    // image content-type + size limit.
    match /posts/{postId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                   isAllowedImageType() &&
                   underMaxSize();
    }

    // ---------- Team images (TeamUp) ----------
    match /teams/{teamId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                   isAllowedImageType() &&
                   underMaxSize();
    }

    // ---------- Marketing campaigns (Super Admin only) ----------
    match /marketing/{campaignId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() && isAllowedImageType() && underMaxSize();
    }

    // ---------- Tournaments (Super Admin only) ----------
    match /tournaments/{tournamentId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() && isAllowedImageType() && underMaxSize();
    }

    // ---------- Products (marketplace images) ----------
    // Paths: products/{productId|draft_*|temp}/{fileName}
    // Product *document* writes remain Super-Admin-only in Firestore rules.
    // Storage allows any signed-in user for image bytes so uploads are not
    // blocked when Storage→Firestore role lookups fail (common cause of
    // storage/unauthorized on marketplace images).
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                             isAllowedImageType() &&
                             underMaxSize();
      allow delete: if isAuthenticated() &&
                     (canManageMarketplaceMedia() || isSuperAdmin());
    }

    // ---------- Expense receipts ----------
    match /expenses/{expenseId}/{allPaths=**} {
      allow read: if isSuperAdmin() || isVenueManager();
      allow write: if (isSuperAdmin() || isVenueManager()) && underMaxSize();
    }

    // ---------- Staff avatars ----------
    match /staff/{staffId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if (isSuperAdmin() || isVenueManager()) &&
                   isAllowedImageType() &&
                   underMaxSize();
    }

    // ---------- App Settings (Logo, etc. — Super Admin only) ----------
    match /app-settings/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() && underMaxSize();
    }

    // ---------- Default deny ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
