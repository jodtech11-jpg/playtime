rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data :
             null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData() != null &&
             getUserData().role == 'super_admin';
    }

    // Venue managers and custom admin roles. A custom role counts as an
    // admin-panel role only when a matching roles/{roleId} document exists;
    // it is venue/vendor scoped exactly like venue_manager.
    function isVenueManager() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData() != null &&
             getUserData().status == 'Active' &&
             (getUserData().role == 'venue_manager' ||
              ('role' in getUserData() &&
               getUserData().role is string &&
               !(getUserData().role in ['super_admin', 'player', 'venue_manager']) &&
               exists(/databases/$(database)/documents/roles/$(getUserData().role))));
    }

    function ownsVenue(venueId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         getUserData() != null &&
         'managedVenues' in getUserData() &&
         venueId in getUserData().managedVenues)
      );
    }

    // Vendor-scoped documents carry the creator's Firebase Auth UID as vendorId.
    function ownsVendorResource() {
      return isAuthenticated() &&
             resource != null &&
             resource.data.vendorId == request.auth.uid;
    }

    function vendorCreatesOwn() {
      return isAuthenticated() &&
             request.resource.data.vendorId == request.auth.uid;
    }

    function vendorManagesVenueOnCreate() {
      // Vendors must always attach a venue they own (no null / Global-style creates)
      return request.resource.data.venueId != null &&
             ownsVenue(request.resource.data.venueId);
    }

    function vendorManagesVenueOnResource() {
      return resource.data.venueId == null ||
             ownsVenue(resource.data.venueId);
    }

    // Create-time binding: the new document's userId must equal the caller's uid.
    function createdByCaller() {
      return request.resource.data.userId == request.auth.uid;
    }

    function hasNoPaymentOrPricingFields() {
      return !request.resource.data.keys().hasAny([
        'amount', 'price', 'subtotal', 'discount', 'shippingCost', 'tax', 'total',
        'paymentId', 'paymentTransactionId', 'transactionId', 'razorpayPaymentId',
        'razorpayOrderId', 'paymentMethod', 'paymentGateway', 'paymentReference'
      ]);
    }

    function isSafePendingBookingCreate() {
      return request.resource.data.keys().hasOnly([
               'userId', 'venueId', 'venue', 'venueImage', 'courtId', 'court',
               'sport', 'startTime', 'endTime', 'duration', 'date', 'time',
               'status', 'paymentStatus', 'slotLockId', 'createdAt', 'updatedAt'
             ]) &&
             request.resource.data.status == 'Pending' &&
             request.resource.data.paymentStatus == 'Pending' &&
             hasNoPaymentOrPricingFields();
    }

    function isSafePendingMembershipCreate() {
      return request.resource.data.keys().hasOnly([
               'userId', 'venueId', 'planId', 'planName', 'planType',
               'startDate', 'endDate', 'status', 'paymentStatus',
               'createdAt', 'updatedAt'
             ]) &&
             request.resource.data.status == 'Pending' &&
             request.resource.data.paymentStatus == 'Pending' &&
             hasNoPaymentOrPricingFields();
    }

    function isSafePendingOrderCreate() {
      // Item requests contain productId + quantity only. Trusted server code
      // re-reads products and computes all prices/totals before payment.
      return request.resource.data.keys().hasOnly([
               'userId', 'userName', 'userEmail', 'userPhone', 'orderNumber',
               'cartId', 'items', 'shippingAddress', 'venueId', 'venueName',
               'status', 'paymentStatus', 'createdAt', 'updatedAt'
             ]) &&
             request.resource.data.items is list &&
             request.resource.data.items.size() > 0 &&
             request.resource.data.items.size() <= 100 &&
             request.resource.data.status == 'Pending' &&
             request.resource.data.paymentStatus == 'Pending' &&
             hasNoPaymentOrPricingFields();
    }

    function playerCancelsOnly() {
      return resource.data.userId == request.auth.uid &&
             (
               (resource.data.status in ['Pending', 'Confirmed', 'Processing'] &&
                request.resource.data.status == 'Cancelled' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'cancelReason', 'cancellationReason',
                  'cancellationRequestedAt', 'cancelledAt', 'updatedAt'
                ])) ||
               (request.resource.data.status == resource.data.status &&
                request.resource.data.paymentStatus == resource.data.paymentStatus &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'cancelRequested', 'cancellationRequested',
                  'cancelReason', 'cancellationReason',
                  'cancellationRequestedAt', 'updatedAt'
                ]))
             );
    }

    function userHasManagedVenueAffinity() {
      return isVenueManager() && (
        ('venueId' in resource.data && ownsVenue(resource.data.venueId)) ||
        ('venueIds' in resource.data &&
         resource.data.venueIds is list &&
         resource.data.venueIds.hasAny(getUserData().managedVenues))
      );
    }

    function hasValidPlayerBookingWindow() {
      return request.resource.data.startTime is timestamp &&
             request.resource.data.endTime is timestamp &&
             request.resource.data.startTime >= request.time + duration.value(15, 'm') &&
             request.resource.data.endTime > request.resource.data.startTime;
    }

    // ---------- Users ----------
    // Venue managers may read user docs by ID (needed for customer lookup from
    // bookings/memberships). Client hooks only fetch users linked to managed venues.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        userId == request.auth.uid ||
        (request.auth.token.phone_number != null &&
         resource.data.phone == request.auth.token.phone_number) ||
        (request.auth.token.email != null &&
         resource.data.email == request.auth.token.email) ||
        isSuperAdmin() ||
        userHasManagedVenueAffinity()
      );
      // - Unauthenticated vendor signup: status=Pending, role=venue_manager, self-id.
      // - Authenticated self-signup: role=player or null.
      // - Super admins can create any user. Other admin account creation is
      //   server-only so venue assignments can be scope-checked.
      allow create: if (
        (request.auth == null &&
         request.resource.data.status == 'Pending' &&
         request.resource.data.role == 'venue_manager' &&
         userId == request.resource.data.id &&
         (!('managedVenues' in request.resource.data) ||
          request.resource.data.managedVenues.size() == 0) &&
         (!('customPermissions' in request.resource.data) ||
          request.resource.data.customPermissions.size() == 0)) ||
        (isAuthenticated() && userId == request.auth.uid &&
         (request.resource.data.role == 'player' || request.resource.data.role == null) &&
         (!('walletBalance' in request.resource.data) ||
          request.resource.data.walletBalance == 0) &&
         (!('managedVenues' in request.resource.data) ||
          request.resource.data.managedVenues.size() == 0) &&
         (!('customPermissions' in request.resource.data) ||
          request.resource.data.customPermissions.size() == 0)) ||
        (isAuthenticated() && isSuperAdmin())
      );
      // - Self-updates may not change role/status/managedVenues/customPermissions
      //   (no self-escalation).
      // Role, approval status, venue assignments, and permission grants are
      // server-controlled. The admin HTTP functions use the Admin SDK after
      // checking the caller's role and venue scope.
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'status', 'managedVenues', 'customPermissions', 'walletBalance'])) ||
        (isVenueManager() &&
         userHasManagedVenueAffinity() &&
         resource.data.role != 'super_admin' &&
         request.resource.data.role != 'super_admin' &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'status', 'managedVenues', 'customPermissions', 'walletBalance']))
      );
      allow delete: if isAuthenticated() &&
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     isSuperAdmin();

      match /favorites/{favoriteId} {
        allow read: if isAuthenticated() && userId == request.auth.uid;
        allow create: if isAuthenticated() &&
                       userId == request.auth.uid &&
                       request.resource.data.venueId is string;
        allow delete: if isAuthenticated() && userId == request.auth.uid;
      }
    }

    // ---------- Roles (read: admin panel roles; write: Super Admin only) ----------
    match /roles/{roleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isVenueManager());
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Permissions (read: admin panel roles; write: Super Admin only) ----------
    match /permissions/{permissionId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isVenueManager());
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Venues ----------
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         request.resource.data.managerId == request.auth.uid &&
         request.resource.data.status == 'Pending')
      );
      allow update: if ownsVenue(venueId);
      allow delete: if isSuperAdmin();
    }

    // ---------- Courts ----------
    // Venue managers may only write courts of venues they manage.
    match /courts/{courtId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.venueId != null && ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Bookings ----------
    // Full booking documents contain customer/payment data and are never used as
    // a public availability feed. Use courtAvailability for sanitized slot data.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && (
        (createdByCaller() &&
         hasValidPlayerBookingWindow() &&
         isSafePendingBookingCreate()) ||
        isSuperAdmin() ||
        (isVenueManager() &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource != null && playerCancelsOnly())
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Sanitized court availability ----------
    // Server-maintained documents must contain slot/court state only, never user,
    // contact, payment, order, or membership fields. Admin SDK writes bypass rules.
    match /courtAvailability/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ---------- Serialized slot locks ----------
    // Locks contain slot metadata only; the linked booking establishes ownership.
    match /booking_slot_locks/{lockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    hasValidPlayerBookingWindow() &&
                    request.resource.data.keys().hasOnly([
                      'venueId', 'courtId', 'startTime', 'endTime',
                      'bookingId', 'createdAt'
                    ]) &&
                    request.resource.data.venueId is string &&
                    request.resource.data.courtId is string &&
                    request.resource.data.bookingId is string &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId
                      == request.auth.uid &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotLockId
                      == lockId &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.venueId
                      == request.resource.data.venueId &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.courtId
                      == request.resource.data.courtId &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.startTime
                      == request.resource.data.startTime &&
                    getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.endTime
                      == request.resource.data.endTime;
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null &&
         get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId
           == request.auth.uid)
      );
    }

    // ---------- Memberships ----------
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        resource.data.userId == request.auth.uid
      );
      // Players may only open an unpriced Pending membership request. Trusted
      // server code resolves plan pricing and payment state.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (createdByCaller() &&
         isSafePendingMembershipCreate()) ||
        (isVenueManager() &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        playerCancelsOnly() ||
        (isVenueManager() &&
         resource.data.venueId != null &&
         ownsVenue(resource.data.venueId))
      );
      allow delete: if isSuperAdmin();
    }

    // ---------- Membership Plans (Super Admin write) ----------
    match /membershipPlans/{planId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Staff ----------
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.venueId != null && ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Expenses ----------
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.venueId != null && ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Salary Records ----------
    match /salaryRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.venueId != null && ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Posts (Social Feed) ----------
    match /posts/{postId} {
      allow read: if isAuthenticated() && (
        resource.data.status == 'Approved' ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
                     createdByCaller() &&
                     request.resource.data.status == 'Pending';
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['content', 'imageUrl', 'images', 'updatedAt'])
        ) ||
        // Social interaction counter updates (counters only; content unchanged)
        (
          resource.data.status == 'Approved' &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['likes', 'comments', 'updatedAt']) &&
          request.resource.data.content == resource.data.content
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        resource.data.userId == request.auth.uid
      );

      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      createdByCaller() &&
                      get(/databases/$(database)/documents/posts/$(postId)).data.status == 'Approved';
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      createdByCaller() &&
                      get(/databases/$(database)/documents/posts/$(postId)).data.status == 'Approved';
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }

    // ---------- Categories (Super Admin only) ----------
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Sports (Super Admin write; all users read) ----------
    match /sports/{sportId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Products ----------
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null &&
         ownsVenue(resource.data.venueId) &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Quick Matches ----------
    // Players can read open/active matches so they appear in the mobile app.
    match /quickMatches/{matchId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsVendorResource() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource.data.status in ['Open', 'Full', 'Started', 'Completed'])
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (vendorCreatesOwn() &&
         vendorManagesVenueOnCreate())
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() && vendorManagesVenueOnResource())
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsVendorResource()
      );
    }

    // ---------- Leaderboards / Polls / Flash Deals ----------
    match /leaderboards/{leaderboardId} {
      // Leaderboards are player-facing Social Hub content. All current types
      // are public to signed-in users; writes remain vendor/admin scoped.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (vendorCreatesOwn() &&
         vendorManagesVenueOnCreate())
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() && vendorManagesVenueOnResource())
      );
    }
    match /polls/{pollId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsVendorResource() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource.data.status in ['Active', 'Closed'])
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (vendorCreatesOwn() &&
         vendorManagesVenueOnCreate())
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() && vendorManagesVenueOnResource())
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() && vendorManagesVenueOnResource())
      );
    }
    match /flashDeals/{dealId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsVendorResource() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource.data.status in ['Upcoming', 'Active', 'Expired'])
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (vendorCreatesOwn() &&
         vendorManagesVenueOnCreate())
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() && vendorManagesVenueOnResource())
      );
    }

    // ---------- Orders ----------
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() &&
                    createdByCaller() &&
                    isSafePendingOrderCreate();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource != null && playerCancelsOnly())
      );
      allow delete: if isSuperAdmin();
    }

    // ---------- Tournaments ----------
    // Players can browse open/ongoing tournaments and register from the mobile app.
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsVendorResource() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource.data.status in ['Open', 'Registration Closed', 'Ongoing', 'Completed'])
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (vendorCreatesOwn() &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (ownsVendorResource() &&
         resource.data.venueId != null &&
         ownsVenue(resource.data.venueId))
      );

      // Player registrations are created/deleted only by the transactional
      // registerTournamentPlayer HTTP endpoint. Clients can read their own
      // registration; venue admins can read registrations for managed events.
      match /registrations/{registrationId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin() ||
          ownsVenue(
            get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.venueId
          )
        );
        allow create, update, delete: if false;
      }
    }

    // ---------- Reports (moderation) ----------
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      // Any authenticated user can create a report about themselves/other content,
      // but the report must carry their uid as reporterId/userId to prevent impersonation.
      allow create: if isAuthenticated() &&
                     request.resource.data.status == 'Pending' &&
                     (('userId' in request.resource.data) ||
                      ('reporterId' in request.resource.data)) &&
                     (!('userId' in request.resource.data) ||
                      request.resource.data.userId == request.auth.uid) &&
                     (!('reporterId' in request.resource.data) ||
                      request.resource.data.reporterId == request.auth.uid) &&
                     !request.resource.data.keys().hasAny([
                       'resolvedBy', 'resolvedAt', 'moderatedBy', 'moderatedAt'
                     ]);
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
    }

    // ---------- Marketing Campaigns ----------
    // Campaign drafts (including Global drafts) are never player-readable.
    match /marketingCampaigns/{campaignId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.status == 'Live' ||
        (resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Support Tickets ----------
    // Vendors see tickets for managed venues (or assigned to them).
    // Legacy tickets without venueId remain readable by super admins only
    // (plus the ticket owner / assignee).
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.assignedTo != null && resource.data.assignedTo == request.auth.uid) ||
        (isVenueManager() &&
         resource != null &&
         resource.data.venueId != null &&
         ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && createdByCaller();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.assignedTo != null && resource.data.assignedTo == request.auth.uid) ||
        (isVenueManager() &&
         resource != null &&
         resource.data.venueId != null &&
         ownsVenue(resource.data.venueId))
      );
      allow delete: if isSuperAdmin();
    }

    // ---------- App Settings ----------
    match /appSettings/{settingsId} {
      allow read: if isAuthenticated() && (
        settingsId == 'public' ||
        (settingsId == 'platform' && isSuperAdmin())
      );
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Landing Page / CMS Pages (public read) ----------
    match /landingPage/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }
    match /cmsPages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Notifications ----------
    // Super admins: all. Venue managers: only notifications they created.
    // Recipients can always read their own per-user notification docs.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isVenueManager() &&
         resource.data.createdBy != null &&
         resource.data.createdBy == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.targetAudience == 'Venue Users' &&
         request.resource.data.targetVenueId != null &&
         ownsVenue(request.resource.data.targetVenueId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         resource.data.createdBy != null &&
         resource.data.createdBy == request.auth.uid &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.targetAudience == 'Venue Users' &&
         request.resource.data.targetVenueId != null &&
         ownsVenue(request.resource.data.targetVenueId)) ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isRead', 'read', 'readAt', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isVenueManager() &&
         resource.data.createdBy != null &&
         resource.data.createdBy == request.auth.uid)
      );
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && isSuperAdmin();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isRead', 'read', 'readAt', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (
        userId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // ---------- Teams (TeamUp) ----------
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                     request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.createdBy == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.createdBy == request.auth.uid)
      );
    }

    // ---------- FCM Tokens ----------
    // Token values are credentials: only the owner and super admin may read them.
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() &&
                    createdByCaller() &&
                    request.resource.data.keys().hasOnly([
                      'token', 'userId', 'isActive', 'deviceType', 'platform',
                      'lastUsedAt', 'createdAt', 'updatedAt'
                    ]);
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'token', 'isActive', 'deviceType', 'platform', 'lastUsedAt', 'updatedAt'
         ]))
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // ---------- Invoices ----------
    // Super admins: all invoices. Venue managers: only invoices for managed venues.
    // Legacy invoices without venueId are super-admin-only for reads.
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         resource != null &&
         resource.data.venueId != null &&
         ownsVenue(resource.data.venueId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId))
      );
      allow update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Payments ----------
    // Online/client payment mutations are server-only. A venue operator may
    // preserve the existing offline settlement flow for a managed venue.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId)) ||
        (resource != null && resource.data.userId != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isVenueManager() &&
         request.resource.data.venueId != null &&
         ownsVenue(request.resource.data.venueId) &&
         request.resource.data.type == 'Offline' &&
         request.resource.data.direction == 'VenueToPlatform' &&
         request.resource.data.sourceType == 'Settlement' &&
         exists(/databases/$(database)/documents/settlements/$(request.resource.data.sourceId)) &&
         get(/databases/$(database)/documents/settlements/$(request.resource.data.sourceId)).data.venueId
           == request.resource.data.venueId &&
         get(/databases/$(database)/documents/settlements/$(request.resource.data.sourceId)).data.amount
           == request.resource.data.amount &&
         request.resource.data.confirmedBy == request.auth.uid &&
         request.resource.data.status == 'Completed' &&
         !request.resource.data.keys().hasAny([
           'paymentGateway', 'razorpayPaymentId', 'razorpayOrderId'
         ]))
      );
      allow update: if isAuthenticated() && isSuperAdmin();
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Settlements ----------
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.venueId != null && ownsVenue(resource.data.venueId))
      );
      allow create: if false;
      allow update: if isAuthenticated() && isSuperAdmin();
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // ---------- Payment reconciliation findings ----------
    // Written only by the explicitly invoked Admin SDK reconciliation script.
    match /reconciliationIssues/{issueId} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ---------- Wallet Transactions ----------
    match /walletTransactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create, update, delete: if false;
    }

    // ---------- Wallet Top-ups ----------
    // Created and finalized by trusted Cloud Functions (Admin SDK bypasses rules).
    match /walletTopups/{topUpId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create, update, delete: if false;
    }

    // ---------- Activity / Audit Log ----------
    // Authenticated callers may append entries, but the entry's userId must match
    // the caller's uid to prevent audit-log forgery. Never updatable or deletable.
    match /activityLog/{logId} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow create: if isAuthenticated() && createdByCaller();
      allow update, delete: if false;
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
